// NewPathEscapingAPIClient wraps apiClient so string path params are URL path
// escaped before request construction. Wrapping is idempotent.
func NewPathEscapingAPIClient(apiClient runtime.APIClient) runtime.APIClient {
    if apiClient == nil {
        return nil
    }
    if _, ok := apiClient.(pathEscapingAPIClient); ok {
        return apiClient
    }
    return pathEscapingAPIClient{APIClient: apiClient}
}

type pathEscapingAPIClient struct {
    runtime.APIClient
}

func (c pathEscapingAPIClient) CreateRequest(ctx context.Context, params runtime.RequestOptionsParameters, reqEditors ...runtime.RequestEditorFn) (*http.Request, error) {
    var multipartBody io.ReadCloser
    if params.ContentType == "multipart/form-data" && !isNilRequestOptions(params.Options) && params.Options.GetBody() != nil {
        body, contentType := encodeMultipartBody(params.Options.GetBody())
        multipartBody = body
        params.Options = bodylessRequestOptions{RequestOptions: params.Options}
        reqEditors = append([]runtime.RequestEditorFn{func(_ context.Context, req *http.Request) error {
            req.Body = body
            req.ContentLength = -1
            req.GetBody = nil
            req.Header.Set("Content-Type", contentType)
            return nil
        }}, reqEditors...)
    }
    if isNilRequestOptions(params.Options) {
        params.Options = nil
    } else {
        params.Options = pathEscapingRequestOptions{RequestOptions: params.Options}
    }
    req, err := c.APIClient.CreateRequest(ctx, params, reqEditors...)
    if err != nil && multipartBody != nil { _ = multipartBody.Close() }
    return req, err
}

// The runtime only encodes JSON and URL-encoded forms. Supply multipart as a
// stream and hide the original body from its JSON encoder.
type bodylessRequestOptions struct { runtime.RequestOptions }
func (bodylessRequestOptions) GetBody() any { return nil }

func encodeMultipartBody(body any) (io.ReadCloser, string) {
    reader, writer := io.Pipe()
    form := multipart.NewWriter(writer)
    contentType := form.FormDataContentType()
    go func() {
        err := func() error {
            value := reflect.ValueOf(body)
            if value.Kind() == reflect.Pointer {
                if value.IsNil() { return fmt.Errorf("multipart body is nil") }
                value = value.Elem()
            }
            if value.Kind() != reflect.Struct { return fmt.Errorf("multipart body must be an object") }
            for i := 0; i < value.NumField(); i++ {
                field := value.Field(i)
                definition := value.Type().Field(i)
                if definition.PkgPath != "" { continue }
                name := strings.Split(definition.Tag.Get("json"), ",")[0]
                if name == "-" { continue }
                if name == "" { name = definition.Name }
                if field.Kind() == reflect.Pointer {
                    if field.IsNil() { continue }
                    field = field.Elem()
                }
                switch data := field.Interface().(type) {
                case runtime.File:
                    file, err := data.Reader()
                    if err != nil { return err }
                    part, err := form.CreateFormFile(name, data.Filename())
                    if err == nil { _, err = io.Copy(part, file) }
                    closeErr := file.Close()
                    if err != nil { return err }
                    if closeErr != nil { return closeErr }
                case string:
                    if err := form.WriteField(name, data); err != nil { return err }
                default:
                    return fmt.Errorf("unsupported multipart field %s", name)
                }
            }
            return form.Close()
        }()
        _ = writer.CloseWithError(err)
    }()
    return reader, contentType
}

func isNilRequestOptions(options runtime.RequestOptions) bool {
    if options == nil {
        return true
    }
    value := reflect.ValueOf(options)
    switch value.Kind() {
    case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
        return value.IsNil()
    default:
        return false
    }
}

type pathEscapingRequestOptions struct {
    runtime.RequestOptions
}

func (o pathEscapingRequestOptions) GetPathParams() (map[string]any, error) {
    if o.RequestOptions == nil {
        return nil, nil
    }
    params, err := o.RequestOptions.GetPathParams()
    if err != nil || len(params) == 0 {
        return params, err
    }
    escaped := make(map[string]any, len(params))
    for key, value := range params {
        if raw, ok := value.(string); ok {
            escaped[key] = url.PathEscape(raw)
            continue
        }
        escaped[key] = value
    }
    return escaped, nil
}

func (o pathEscapingRequestOptions) GetQuery() (map[string]any, error) {
    if o.RequestOptions == nil {
        return nil, nil
    }
    params, err := o.RequestOptions.GetQuery()
    if err != nil { return nil, err }
    // The runtime's JSON map converts integers to floats. Preserve the byte
    // limit so large values do not become invalid scientific query notation.
    if options, ok := o.RequestOptions.(*AttachmentTextRequestOptions); ok && options.Query != nil && options.Query.MaxBytes != nil {
        params["max_bytes"] = *options.Query.MaxBytes
    }
    return params, nil
}

func (o pathEscapingRequestOptions) GetBody() any {
    if o.RequestOptions == nil {
        return nil
    }
    return o.RequestOptions.GetBody()
}

func (o pathEscapingRequestOptions) GetHeader() (map[string]string, error) {
    if o.RequestOptions == nil {
        return nil, nil
    }
    return o.RequestOptions.GetHeader()
}

// New{{$clientName}} creates a new instance of the {{$clientName}} client.
func New{{$clientName}}(apiClient runtime.APIClient) *{{$clientName}} {
    return &{{$clientName}}{apiClient: NewPathEscapingAPIClient(apiClient)}
}

// NewDefault{{$clientName}} creates a new instance of the {{$clientName}} client with default api client.
func NewDefault{{$clientName}}(baseURL string, opts ...runtime.APIClientOption) (*{{$clientName}}, error) {
    apiClient, err := runtime.NewAPIClient(baseURL, opts...)
    if err != nil {
        return nil, fmt.Errorf("error creating API client: %w", err)
    }
    return &{{$clientName}}{apiClient: NewPathEscapingAPIClient(apiClient)}, nil
}

