{
  "name": "@kenn-io/kata-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "generate": "bun run scripts/generate-api.ts",
    "generate:check": "bun run scripts/generate-api.ts --check",
    "typecheck": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:kit-ui": "kit-ui-check src",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run generate:check && bun run typecheck && bun run check:svelte && bun run check:kit-ui && bun run lint && bun run format:check",
    "audit": "bun audit --audit-level high",
    "test": "vp test",
    "test:browser": "vp test --project browser",
    "test:e2e": "playwright test --grep-invert @firefox",
    "test:e2e:firefox": "playwright test --grep @firefox",
    "build": "vp build",
    "dev": "vp dev"
  },
  "dependencies": {
    "@kenn-io/kata-ui": "workspace:*",
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#91a19e58add5696a7370ec2ace738a888d449ba6",
    "@lucide/svelte": "1.21.0",
    "@xyflow/svelte": "1.6.1",
    "elkjs": "0.11.1",
    "svelte": "5.56.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "es-module-lexer": "3.0.4",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.15.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "orval": "8.26.0",
    "parse5": "8.0.1",
    "postcss": "8.5.25",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.54.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  }
}
