{
  "name": "@kenn-io/kata-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "scripts": {
    "generate": "bun run scripts/generate-api.ts",
    "generate:check": "bun run scripts/generate-api.ts --check",
    "typecheck": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run generate:check && bun run typecheck && bun run check:svelte && bun run lint && bun run format:check",
    "audit": "bun audit --audit-level high",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "build": "vite build",
    "dev": "vite"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#97be355ef25a02ce96de6da4f3627ed5b922c4c3",
    "@lucide/svelte": "1.21.0",
    "@xyflow/svelte": "1.6.1",
    "elkjs": "0.11.1",
    "openapi-fetch": "0.17.0",
    "svelte": "5.56.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.10.0",
    "es-module-lexer": "2.3.1",
    "eslint": "9.39.2",
    "eslint-plugin-svelte": "3.15.0",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "parse5": "8.0.1",
    "postcss": "8.5.25",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
