{
  "name": "@kenn-io/kata-ui",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "svelte": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./compatibility": {
      "types": "./src/compatibility.ts",
      "default": "./src/compatibility.ts"
    }
  },
  "files": [
    "README.md",
    "src/index.ts",
    "src/types.ts",
    "src/compatibility.ts",
    "src/projectIssueDetail.ts",
    "src/IssueDetail.svelte",
    "src/components"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "bun run typecheck && bun run check:svelte"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#97be355ef25a02ce96de6da4f3627ed5b922c4c3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.10.0",
    "jsdom": "29.1.1",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.56.3"
  },
  "packageManager": "bun@1.3.14"
}
